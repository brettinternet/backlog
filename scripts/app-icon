#!/usr/bin/env swift
// Render assets/AppIcon.icon to assets/app-icon.png the way macOS draws it (requires Xcode 26+).
import AppKit

let assets = URL(fileURLWithPath: FileManager.default.currentDirectoryPath).appendingPathComponent("assets")
let temp = FileManager.default.temporaryDirectory.appendingPathComponent("bl-app-icon-\(UUID().uuidString)")
defer { try? FileManager.default.removeItem(at: temp) }
let resources = temp.appendingPathComponent("Icon.bundle/Contents/Resources")
try FileManager.default.createDirectory(at: resources, withIntermediateDirectories: true)
// Without these keys AppKit skips Assets.car and falls back to the 256 px AppIcon.icns.
try (["CFBundleIdentifier": "dev.bl.app-icon", "CFBundleIconName": "AppIcon"] as NSDictionary)
    .write(to: resources.deletingLastPathComponent().appendingPathComponent("Info.plist"))

let actool = Process()
actool.executableURL = URL(fileURLWithPath: "/usr/bin/xcrun")
actool.arguments = ["actool", assets.appendingPathComponent("AppIcon.icon").path,
                    "--compile", resources.path, "--app-icon", "AppIcon",
                    "--platform", "macosx", "--minimum-deployment-target", "26.0",
                    "--output-partial-info-plist", temp.appendingPathComponent("partial.plist").path]
actool.standardOutput = FileHandle.nullDevice
try actool.run()
actool.waitUntilExit()
guard actool.terminationStatus == 0,
      let icon = Bundle(url: temp.appendingPathComponent("Icon.bundle"))?.image(forResource: "AppIcon")
else { fatalError("actool could not compile assets/AppIcon.icon") }

let px = 1024
let rep = NSBitmapImageRep(bitmapDataPlanes: nil, pixelsWide: px, pixelsHigh: px, bitsPerSample: 8,
                           samplesPerPixel: 4, hasAlpha: true, isPlanar: false,
                           colorSpaceName: .deviceRGB, bytesPerRow: 0, bitsPerPixel: 0)!
NSGraphicsContext.saveGraphicsState()
NSGraphicsContext.current = NSGraphicsContext(bitmapImageRep: rep)
icon.draw(in: NSRect(x: 0, y: 0, width: px, height: px))
NSGraphicsContext.restoreGraphicsState()
try rep.representation(using: .png, properties: [:])!.write(to: assets.appendingPathComponent("app-icon.png"))
