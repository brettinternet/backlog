{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "root": {
      "enum": [
        "primary",
        "checkout"
      ]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "highContrast": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "native",
              "backlog-md",
              "beads",
              "github",
              "linear",
              "jira",
              "external"
            ]
          },
          "path": {
            "type": "string"
          },
          "prefix": {
            "type": "string"
          },
          "team": {
            "type": "string"
          },
          "account": {
            "type": "string"
          },
          "site": {
            "type": "string"
          },
          "project": {
            "type": "string"
          },
          "host": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          },
          "run": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "type"
        ]
      }
    },
    "statuses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "enum": [
              "backlog",
              "todo",
              "active",
              "done",
              "canceled"
            ]
          }
        },
        "required": [
          "key",
          "name",
          "category"
        ]
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "string"
        },
        "done": {
          "type": "string"
        }
      }
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "archived": {
            "type": "boolean"
          }
        },
        "required": [
          "key",
          "name"
        ]
      }
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ready": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "statuses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "satisfiedBy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excludeLabels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skipContainers": {
          "type": "boolean"
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string"
        },
        "dod": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "query": {
            "type": "string"
          },
          "sort": {
            "type": "string"
          },
          "group": {
            "type": "string"
          },
          "layout": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "coordination": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "worklease": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        }
      }
    },
    "hooks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "on": {
            "type": "string"
          },
          "if": {
            "type": "string"
          },
          "phase": {
            "enum": [
              "before",
              "after"
            ]
          },
          "cwd": {
            "type": "string"
          },
          "run": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "timeout": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "on",
          "run"
        ]
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "when": {
            "type": "string"
          },
          "cwd": {
            "type": "string"
          },
          "run": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confirm": {
            "type": "boolean"
          },
          "detach": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "run"
        ]
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bl project configuration"
}
