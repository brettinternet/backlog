#!/usr/bin/env python3
"""Capture bl's alternate screen in a private tmux server, never the user's panes."""
import argparse
import os
import shlex
import subprocess
import sys
import threading
import time
import uuid


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--width', type=int, default=80)
    parser.add_argument('--height', type=int, default=24)
    parser.add_argument('--timeout', type=float, default=15)
    parser.add_argument('--keys', nargs='*', default=[], help='tmux keys sent after the first paint')
    parser.add_argument('command', nargs=argparse.REMAINDER, help='-- bin/bl -C FIXTURE tui')
    args = parser.parse_args()
    command = args.command
    if command[:1] == ['--']:
        command = command[1:]
    if not command:
        command = ['bin/bl']
    if min(args.width, args.height) < 1 or args.timeout <= 0:
        parser.error('dimensions and timeout must be positive')
    socket = 'bl-snapshot-' + uuid.uuid4().hex
    base = ['tmux', '-L', socket, '-f', os.devnull]

    def tmux(*argv, check=True):
        return subprocess.run(base + list(argv), text=True, capture_output=True,
                              check=check, timeout=args.timeout)

    try:
        tmux('new-session', '-d', '-s', 'snapshot', '-x', str(args.width),
             '-y', str(args.height), shlex.join(command))
        tmux('set-option', '-g', 'status', 'off')
        deadline = time.monotonic() + args.timeout
        keys_sent = False
        previous = None
        while time.monotonic() < deadline:
            pane = tmux('capture-pane', '-p', '-t', 'snapshot:0.0').stdout
            ready = ('q quit' in pane or 'esc/q back' in pane or 'esc back' in pane) and 'Loading' not in pane and '⠋ syncing' not in pane and '⠋ Searching' not in pane
            if ready and not keys_sent and args.keys:
                tmux('send-keys', '-t', 'snapshot:0.0', *args.keys)
                keys_sent = True
                previous = None
            elif ready and pane == previous:
                sys.stdout.write(pane)
                return 0
            else:
                previous = pane
            threading.Event().wait(0.05)
        raise RuntimeError('render did not settle before timeout; last capture:\n' + (previous or ''))
    finally:
        tmux('kill-server', check=False)


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, subprocess.SubprocessError, RuntimeError) as error:
        print(f'tui-snapshot: {error}', file=sys.stderr)
        sys.exit(1)
