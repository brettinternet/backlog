#!/usr/bin/env python3
"""Standalone release build and fail-closed GitHub CI gate."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import tarfile
import tempfile


def run(*args, **kwargs):
    return subprocess.check_output(args, text=True, **kwargs).strip()


def require_ci(pages, sha, repository):
    runs = [r for page in pages for r in page["workflow_runs"]
            if r.get("head_sha") == sha and r.get("event") == "push"
            and r.get("head_branch") == "main"
            and r.get("head_repository", {}).get("full_name") == repository]
    if not runs:
        raise ValueError("no main push CI run for tag commit")
    latest = max(runs, key=lambda r: (r["id"], r.get("run_attempt", 1)))
    if latest.get("status") != "completed" or latest.get("conclusion") != "success":
        raise ValueError("latest main push CI run for tag commit did not pass")


def gate():
    sha = run("git", "rev-parse", "HEAD")
    repository = os.environ["GITHUB_REPOSITORY"]
    pages = json.loads(run("gh", "api", "--paginate", "--slurp",
                          f"repos/{repository}/actions/workflows/ci.yaml/runs?head_sha={sha}&event=push&per_page=100"))
    require_ci(pages, sha, repository)
    print(f"CI passed for {sha}")


def build(version):
    if not re.fullmatch(r"v[0-9]+\.[0-9]+\.[0-9]+(?:-[A-Za-z0-9.-]+)?|snapshot", version):
        raise ValueError("version must be vMAJOR.MINOR.PATCH[-PRERELEASE] or snapshot")
    commit = run("git", "rev-parse", "HEAD")
    output = Path("dist")
    output.mkdir(exist_ok=True)
    checksums = []
    with tempfile.TemporaryDirectory(prefix="bl-release-") as temporary:
        binary = Path(temporary) / "bl"
        for system in ("darwin", "linux"):
            for arch in ("arm64", "amd64"):
                subprocess.run(["go", "build", "-trimpath", "-ldflags",
                                f"-s -w -X main.buildVersion={version} -X main.buildCommit={commit}",
                                "-o", str(binary), "./cmd/bl"], check=True,
                               env={**os.environ, "CGO_ENABLED": "0", "GOOS": system, "GOARCH": arch})
                metadata = run("go", "version", "-m", str(binary))
                if ("CGO_ENABLED=0" not in metadata or f"GOOS={system}" not in metadata
                        or f"GOARCH={arch}" not in metadata
                        or version.encode() not in binary.read_bytes()
                        or commit.encode() not in binary.read_bytes()):
                    raise ValueError("missing build metadata")
                archive = output / f"bl_{system}_{arch}.tar.gz"
                with tarfile.open(archive, "w:gz") as tar:
                    tar.add(binary, arcname="bl")
                checksums.append(f"{hashlib.sha256(archive.read_bytes()).hexdigest()}  {archive.name}\n")
                print(f"Built {archive}: {version} ({commit}), CGO_ENABLED=0")
    (output / "checksums.txt").write_text("".join(checksums))


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=["build", "gate"])
    parser.add_argument("--version", default="snapshot")
    args = parser.parse_args()
    if args.command == "gate":
        gate()
    else:
        build(args.version)
