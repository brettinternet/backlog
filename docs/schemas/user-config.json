{
  "description": "User settings in XDG_CONFIG_HOME/backlog/config.yaml. Project overrides apply after backlog.yaml and backlog.local.yaml settle project identity.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "$ref": "project-config.json#/properties/version"
    },
    "git": {
      "$ref": "project-config.json#/properties/git"
    },
    "root": {
      "$ref": "project-config.json#/properties/root"
    },
    "project": {
      "$ref": "project-config.json#/properties/project"
    },
    "ui": {
      "$ref": "project-config.json#/properties/ui"
    },
    "contact": {
      "description": "Contact resolvers looked up for held or recent sessions by bl show. An argv adds a resolver or replaces the built-in herdr or claude-peer of that name; false disables one. Ignored in backlog.yaml and backlog.local.yaml.",
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {"const": false},
          {
            "description": "Argv run without a shell; placeholders {agent}, {agentSession}, {session}, {host}, and {cwd}. Prints a JSON array of {channel, handle, status, detail?}.",
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        ]
      }
    },
    "agents": {
      "description": "Agent kinds recorded on event sessions, merged by key over the built-in claude, codex, and pi. Ignored in backlog.yaml and backlog.local.yaml.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "session": {
            "description": "Environment variable whose non-empty value detects this agent and is its harness session ID.",
            "type": "string",
            "minLength": 1
          },
          "resume": {
            "description": "Argv that continues a recorded session, run without a shell in its checkout. Placeholders include {agentSession}, {session}, {agent}, {cwd}, and {host}.",
            "type": "array",
            "items": {"type": "string"},
            "minItems": 1
          },
          "fork": {
            "description": "Argv that starts a new session from a recorded one; closed items use it when set.",
            "type": "array",
            "items": {"type": "string"},
            "minItems": 1
          },
          "detach": {
            "description": "Run resume and fork in the background instead of attached to the terminal.",
            "type": "boolean"
          }
        }
      }
    },
    "sources": {
      "$ref": "project-config.json#/properties/sources"
    },
    "statuses": {
      "$ref": "project-config.json#/properties/statuses"
    },
    "workflow": {
      "$ref": "project-config.json#/properties/workflow"
    },
    "milestones": {
      "$ref": "project-config.json#/properties/milestones"
    },
    "labels": {
      "$ref": "project-config.json#/properties/labels"
    },
    "ready": {
      "$ref": "project-config.json#/properties/ready"
    },
    "defaults": {
      "$ref": "project-config.json#/properties/defaults"
    },
    "views": {
      "$ref": "project-config.json#/properties/views"
    },
    "coordination": {
      "$ref": "project-config.json#/properties/coordination"
    },
    "history": {
      "$ref": "project-config.json#/properties/history"
    },
    "hooks": {
      "$ref": "project-config.json#/properties/hooks"
    },
    "actions": {
      "$ref": "project-config.json#/properties/actions"
    },
    "me": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": {
          "type": "string"
        }
      }
    },
    "accounts": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "host": {
              "type": "string"
            },
            "user": {
              "type": "string"
            },
            "email": {"type": "string"},
            "credential": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "env": {
              "type": "string"
            },
            "oauth": {
              "type": "boolean",
              "description": "Explicitly opt this user account into the built-in OAuth flow when its provider is available"
            }
          }
        }
      }
    },
    "projects": {
      "type": "object",
      "additionalProperties": {
        "$ref": "project-config.json"
      }
    },
    "workspaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "projects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "projects"
        ]
      }
    },
    "defaultWorkspace": {
      "type": "string"
    },
    "keys": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bl user configuration"
}
