# bl PowerShell completion. Load it with: bl completion pwsh | Out-String | Invoke-Expression

Register-ArgumentCompleter -Native -CommandName bl -ScriptBlock {
    param($wordToComplete, $commandAst, $cursorPosition)
    # PowerShell parses label:a,b as an array and -label:a as a parameter, so
    # words come from their source text rather than $wordToComplete.
    $words = @()
    $current = ''
    foreach ($element in @($commandAst.CommandElements | Select-Object -Skip 1)) {
        $extent = $element.Extent
        if ($extent.StartOffset -ge $cursorPosition) { break }
        $text = $extent.Text
        if ($element -is [System.Management.Automation.Language.StringConstantExpressionAst]) { $text = $element.Value }
        if ($extent.EndOffset -lt $cursorPosition) {
            $words += $text
        } elseif ($extent.EndOffset -eq $cursorPosition) {
            $current = $text
        } else {
            $current = $extent.Text.Substring(0, $cursorPosition - $extent.StartOffset)
        }
    }
    $program = $commandAst.CommandElements[0].Extent.Text
    & $program @words $current --generate-shell-completion 2>$null | ForEach-Object {
        $value, $description = $_ -split "`t", 2
        if (-not $description) { $description = $value }
        $text = $value
        if ($value -match '[\s''"`$,;(){}@#|&<>]') { $text = "'" + $value.Replace("'", "''") + "'" }
        [System.Management.Automation.CompletionResult]::new($text, $value, 'ParameterValue', $description)
    }
}
