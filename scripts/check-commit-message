#!/bin/sh

set -eu

message_file=${1:?usage: check-commit-message <message-file>}
subject=$(sed -n '1p' "$message_file")

case "$subject" in
  "Merge "*|"Revert \""*|"fixup! "*|"squash! "*)
    exit 0
    ;;
esac

pattern='^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([a-z0-9][a-z0-9._/-]*\))?!?: [^ ].*$'

if ! printf '%s\n' "$subject" | grep -Eq "$pattern"; then
  cat >&2 <<'EOF'
Commit subject must follow Conventional Commits:
  <type>(<optional-scope>)<optional-!>: <description>

Examples:
  feat(cli): add process status command
  fix(daemon): preserve stderr on exit
  docs: explain runtime configuration
EOF
  exit 1
fi

case "$subject" in
  *.)
    printf '%s\n' 'Commit subject must not end with a period.' >&2
    exit 1
    ;;
esac
