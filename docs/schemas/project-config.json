{
  "description": "Repository settings for root backlog.yaml and optional backlog.local.yaml. Local overlays project before user projects.<id>; both require trust for privileged entries. Accounts belong in user config.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "autoCommit": { "type": "boolean", "default": false }
      }
    },
    "root": {
      "enum": [
        "primary",
        "checkout"
      ]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "highContrast": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "native",
              "backlog-md",
              "beads",
              "github",
              "linear",
              "jira",
              "external",
              "github-pulls"
            ]
          },
          "path": {
            "type": "string"
          },
          "prefix": {
            "type": "string"
          },
          "team": {
            "type": "string"
          },
          "account": {
            "type": "string"
          },
          "site": {
            "type": "string"
          },
          "project": {
            "type": "string"
          },
          "host": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          },
          "jql": {"type": "string"},
          "cloudId": {"type": "string"},
          "hardLinkTypes": {"type": "array", "items": {"type": "string"}},
          "unsuccessfulResolutions": {"type": "array", "items": {"type": "string"}},
          "allowWrites": {"type": "boolean", "default": false},
          "statuses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "statusLabels": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"enum": ["backlog", "todo", "active", "done", "canceled"]}
          },
          "githubProject": {
            "type": "object",
            "additionalProperties": false,
            "required": ["owner", "number", "id", "fieldId", "options"],
            "properties": {
              "owner": {"type": "string", "minLength": 1},
              "number": {"type": "integer", "minimum": 1},
              "id": {"type": "string", "minLength": 1},
              "fieldId": {"type": "string", "minLength": 1},
              "allowWrites": {"type": "boolean", "default": false},
              "iterationFieldId": {"type": "string", "minLength": 1},
              "options": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {"enum": ["backlog", "todo", "active", "done", "canceled"]}
              }
            }
          },
          "run": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "type"
        ],
        "if": {"properties": {"type": {"const": "github-pulls"}}},
        "then": {
          "required": ["repo"],
          "propertyNames": {"enum": ["id", "type", "repo", "host", "account"]},
          "properties": {"repo": {"pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"}}
        }
      }
    },
    "statuses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "enum": [
              "backlog",
              "todo",
              "active",
              "done",
              "canceled"
            ]
          },
          "includes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "key",
          "name",
          "category"
        ]
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "string"
        },
        "done": {
          "type": "string"
        }
      }
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "archived": {
            "type": "boolean"
          }
        },
        "required": [
          "key",
          "name"
        ]
      }
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ready": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "statuses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "satisfiedBy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excludeLabels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skipContainers": {
          "type": "boolean"
        },
        "sprint": {
          "enum": [
            "current",
            "next"
          ]
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "dod": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "query": {
            "type": "string"
          },
          "sort": {
            "type": "string"
          },
          "group": {
            "type": "string"
          },
          "layout": {
            "type": "string"
          },
          "columns": {
            "type": "array",
            "items": {"enum": ["id", "priority", "status", "blockers", "children", "changes", "claim", "assignee", "updated", "title"]}
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "coordination": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "worklease": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        }
      }
    },
    "changes": {
      "description": "Where linked changes come from (docs/changes.md).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "git": {
          "description": "Read local branches, worktrees, and landed commits from .git.",
          "type": "boolean",
          "default": true
        },
        "forges": {
          "description": "Repositories whose pull or merge requests link to items. Unset uses a GitHub or GitLab origin when exactly one account of that type is configured for its host. Project-layer forges need trust.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "repo"],
            "properties": {
              "type": {"enum": ["github", "gitlab"]},
              "host": {"description": "Default github.com or gitlab.com.", "type": "string"},
              "repo": {"description": "owner/repo, or a GitLab group/project path, which may nest subgroups.", "type": "string", "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)+$"},
              "account": {"description": "A configured account name; defaults to a GitHub source's for the same repository, else the only account of the forge's type for the host.", "type": "string"}
            }
          }
        }
      }
    },
    "tours": {
      "description": "Opt in to agent-written tours (docs/changes.md#tours). Off by default.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "description": "off says nothing about tours; suggest asks agents for a tour of each open change at one of stages; require also refuses done until each has a tour for its current head.",
          "enum": ["off", "suggest", "require"],
          "default": "off"
        },
        "stages": {
          "description": "Which open changes need a tour.",
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["worktree", "branch", "pr"]},
          "default": ["worktree", "branch", "pr"]
        }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "handoff": {
          "description": "Where bl handoff records: local events only, or also a comment on the item.",
          "enum": ["local", "comment"],
          "default": "local"
        },
        "commitTrailer": {
          "description": "Git trailer key that bl instructions workflow asks agents to end each commit for an item with, as KEY: ID. Unset adds no commit guidance.",
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9-]*$"
        }
      }
    },
    "hooks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "on": {
            "type": "string"
          },
          "if": {
            "type": "string"
          },
          "phase": {
            "enum": [
              "before",
              "after"
            ]
          },
          "cwd": {
            "type": "string"
          },
          "run": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "timeout": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "on",
          "run"
        ]
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "when": {
            "type": "string"
          },
          "cwd": {
            "type": "string"
          },
          "run": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confirm": {
            "type": "boolean"
          },
          "detach": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "run"
        ]
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bl project configuration"
}
